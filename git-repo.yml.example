# git-repo configuration file
# Copy to ~/.config/git-repo.yml and edit as needed, or use the CLI:
#
#   git-repo config directory ~/src
#   git-repo config add my-project https://github.com/example/my-project.git
#

directory: ~/src

repositories:
  - name: my-project
    url: https://github.com/example/my-project.git
  - name: another-repo
    url: git@github.com:example/another-repo.git

  # Third-party repositories you clone but do not own: set manage: false so the
  # pull-request and issue commands skip them. Omit it (the default) for repos
  # you manage.
  - name: some-dependency
    url: https://github.com/other/some-dependency.git
    manage: false
